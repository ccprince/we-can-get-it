#!/usr/bin/env bash
# husky invokes this via `sh -e`, which ignores the shebang and can't run the
# process substitution below — re-exec under bash, keeping stdin (git's list of
# refs being pushed) intact across the exec.
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -e

# The PR size budget (ADR 0010). Pushes to main are not guarded here: a decision
# belongs on main, and the pre-commit hook already refuses code there.
current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" != "main" ] && [ -z "$SIZE_EXEMPT" ]; then
  # A stacked branch is measured against the branch it is stacked on, not main:
  # the parent's insertions are already under review in the parent's own PR, and
  # counting them again would fail the child for work it doesn't contain.
  base_branch="${PR_BASE:-}"
  if [ -z "$base_branch" ] && command -v gh >/dev/null 2>&1; then
    base_branch=$(gh pr view "$current_branch" --json baseRefName --jq .baseRefName 2>/dev/null || true)
  fi
  if [ -z "$base_branch" ]; then
    base_branch=$(git config --get "branch.$current_branch.prBase" || true)
  fi
  base_branch=${base_branch:-main}
  base_branch=${base_branch#origin/}

  if git fetch origin "$base_branch" --quiet 2>/dev/null; then
    base_ref="origin/$base_branch"
  elif git rev-parse --verify --quiet "refs/heads/$base_branch" >/dev/null; then
    base_ref="$base_branch"
  else
    echo "PR size budget: base branch '$base_branch' not found on origin or locally — measuring against main."
    git fetch origin main --quiet
    base_branch=main
    base_ref="origin/main"
  fi

  base=$(git merge-base "$base_ref" HEAD)

  # Production is the default bucket: a path counts unless it is a test, a doc or
  # a lockfile. Enumerating what doesn't count fails strict rather than hollow.
  read -r prod_ins prod_files test_ins test_files dels < <(
    git diff --numstat "$base" HEAD -- . ':(exclude)package-lock.json' \
      | awk '{
               a=$1; d=$2; p=$3
               if (a=="-") a=0
               if (d=="-") d=0
               dl+=d
               if (p ~ /\.test\.tsx?$/ || p ~ /^tests\// || p ~ /^docs\// || p ~ /\.md$/) {
                 ti+=a; tf++; next
               }
               pi+=a; pf++
             }
             END { print pi+0, pf+0, ti+0, tf+0, dl+0 }'
  )

  MAX_LINES=400
  MAX_FILES=15

  if [ "$base_branch" != "main" ]; then
    echo "PR size budget: measuring against $base_ref (stacked branch)."
  fi
  echo "PR size budget: $prod_ins production insertions across $prod_files files (budget $MAX_LINES / $MAX_FILES)."
  echo "  reported, never enforced: $test_ins test and doc insertions across $test_files files, $dels deletions."

  if [ "$prod_ins" -gt "$MAX_LINES" ] || [ "$prod_files" -gt "$MAX_FILES" ]; then
    echo
    echo "PR size budget exceeded against $base_ref: $prod_ins production insertions (budget $MAX_LINES) across $prod_files production files (budget $MAX_FILES)."
    echo "A slice is the review unit (docs/agents/workflow.md); stack this one on the last."
    if [ "$base_branch" = "main" ]; then
      echo "If this branch is stacked on another PR, name that PR's branch: PR_BASE=<branch> git push"
      echo "  (or persist it: git config branch.$current_branch.prBase <branch>)"
    fi
    echo "To push anyway, run: SIZE_EXEMPT=1 git push"
    exit 1
  fi
fi
