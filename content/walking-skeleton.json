  "locations": [
    {
      "id": "bellwether",
      "name": "Bellwether Yards",
      "prose": "A repair yard that outgrew its own harbour and never admitted it. Three gantries, a customs shed with a leaking roof, and a market that keeps its own hours.",
      "archetype": "market"
    },
    {
      "id": "kestrel",
      "name": "Kestrel Reach",
      "prose": "A yard town that has outlived three owners and kept all their paperwork. The gate crews here know the hour you arrived and will mention it.",
      "archetype": "processor"
    },
    {
      "id": "shoals",
      "name": "Thennet Shoals",
      "prose": "A day out and already a different trade: tenders, tank farms, and a strip of chandlers who buy anything that will fit through a hatch.",
      "archetype": "processor"
    },
    {
      "id": "caravel",
      "name": "Caravel Station",
      "prose": "A ring of warehouses around a gate that never closes, where everything stops on its way somewhere better. Nobody is from here.",
      "archetype": "market"
    },
    {
      "id": "hollow",
      "name": "Grieve's Hollow",
      "prose": "A cut in a dead moon with one gate and no second way out. What comes up out of the Hollow leaves the way it arrived, or not at all.",
      "archetype": "extractor"
    },
    {
      "id": "lament",
      "name": "Lamentation",
      "prose": "Far enough out that the chart draws it apart from everything, and spoken of at Caravel the way people speak of weather in a country they have never visited.",
      "archetype": "extractor"
    },
    {
      "id": "tallow",
      "name": "Tallow Cross",
      "prose": "Four gates and a market square laid across the middle of them, so that nobody passes through without being sold something on the way.",
      "archetype": "market"
    },
    {
      "id": "quay",
      "name": "Mercy Quay",
      "prose": "A long dock of a station where the berths are let by the hour and the hours are argued over.",
      "archetype": "market"
    },
    {
      "id": "anvil",
      "name": "Anvil Deep",
      "prose": "Foundries sunk into an asteroid's core, where the night shift is the only shift and the slag glows for a week.",
      "archetype": "processor"
    },
    {
      "id": "spindleworks",
      "name": "The Spindleworks",
      "prose": "A mill town of turning drums and lint-thick air, which buys raw and sells it back finished at a price it calls fair.",
      "archetype": "processor"
    },
    {
      "id": "cinder",
      "name": "Cinder Reach",
      "prose": "A burnt-out world still worth digging, where the pits run warm and the diggers keep their own reckoning of the days.",
      "archetype": "extractor"
    },
    {
      "id": "tithe",
      "name": "Tithe Rock",
      "prose": "A claim the size of a county, worked by three families who have not agreed about anything in a generation.",
      "archetype": "extractor"
    }
