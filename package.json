{
  "name": "we-can-get-it",
  "version": "0.0.0",
  "description": "We Can Get It For You — a text space-trading game",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccprince/we-can-get-it.git"
  },
  "type": "module",
  "private": "true",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{json,css,html}\"",
    "test": "vitest run",
    "harness": "vite-node harness/run.ts",
    "frontier": "vite-node tools/frontier.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky",
    "preview": "vite preview"
  }
}
